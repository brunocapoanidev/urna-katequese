# Senha do painel /admin (abrir/encerrar a votação e apurar).
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-unica

# Segredo que assina as sessões. Obrigatório em produção; use 32+ caracteres aleatórios.
AUTH_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Eleitores e códigos, em UMA linha de JSON (obrigatório para alguém conseguir votar).
# Gere códigos novos e secretos; nunca coloque os códigos reais no repositório.
# VOTERS_JSON='[{"id":"jean-lucca","name":"Jean Lucca","code":"K7M4-9QDX"}]'
